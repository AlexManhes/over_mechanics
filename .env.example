# Copie para .env se precisar mudar os padrões. Não envie .env para repositórios.
HOST=127.0.0.1
PORT=3000
# Uso local abre direto no painel. Para exigir contas, use true.
AUTH_REQUIRED=false
# DATA_DIR=C:/caminho/privado/dados-mecanica
# Em produção com HTTPS, descomente e ajuste:
# AUTH_REQUIRED=true
# PUBLIC_ORIGIN=https://oficina.suaempresa.com.br
# COOKIE_SECURE=true
# SETUP_KEY=substitua-por-uma-chave-longa-e-aleatoria
