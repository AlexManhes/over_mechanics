{
  "name": "mecanica-ja",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Acompanhamento de reparos de frota para mecânicos",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node scripts/build-cloud.mjs && node --test tests/*.test.mjs",
    "build:cloud": "node scripts/build-cloud.mjs",
    "dev:cloud": "node scripts/build-cloud.mjs && wrangler dev",
    "deploy:cloud": "node scripts/build-cloud.mjs && wrangler deploy",
    "check:cloud": "node scripts/build-cloud.mjs && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "wrangler": "^4.152.0"
  }
}
